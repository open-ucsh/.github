{
  "$schema": "./tokens.schema.json",
  "typography": {
    "fontFamily": {
      "sans": [
        "Ubuntu",
        "system-ui",
        "-apple-system",
        "Segoe UI",
        "sans-serif"
      ]
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "bold": 700
    }
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "lg": "0.75rem"
  },
  "shadow": {
    "sm": "0 1px 2px rgb(23 50 77 / 0.08)",
    "md": "0 4px 12px rgb(23 50 77 / 0.12)"
  }
}
